@page "/akis"
@using Kampus.Posts
@using Kampuste.Maui.Services.Posts
@inject NavigationManager Navigation
@inject IPostService PostService

<div class="content">
    <div class="tab-bar2">
        <button class="tab-button2" @onclick="ProfileGit"><i class="fa fa-user" aria-hidden="true"></i></button>
        <button class="tab-button2">Genel</button>
        <button class="tab-button2">Üniversite</button>
        <button class="tab-button2">Bölüm</button>
        <button class="tab-button2" @onclick="MesajlaraGit"><i class="fa fa-envelope" aria-hidden="true"></i></button>
    </div>
    <div>
        <div class="posts">
        <!-- Kullanıcı Gönderisi -->
             @foreach (var post in postsdto)
            {
                <div class="post">
                    <div class="post-header">
                        <img src="@post.UserId" alt="Profil Fotoğrafı" class="user-photo" />
                        <span class="username">@post.UserId</span>
                        <span class="post-date">@post.CreationTime.ToString("dd MMMM yyyy")</span>
                    </div>
                    <div class="post-content">
                      @*  @if (!string.IsNullOrEmpty(post.))
                        {
                            <img src="@post.ImageUrl" alt="Resim" />
                        }  *@
                        <p>@post.Content</p>
                    </div>
                    <div class="post-actions">
                        <button class="action-button"><i class="fa fa-thumbs-up" aria-hidden="true"></i></button>
                        <button class="action-button"><i class="fa fa-comment" aria-hidden="true"></i></button>
                        <button class="action-button"><i class="fa fa-bookmark" aria-hidden="true"></i></button>
                    </div>
                </div>
                    }
        </div>
    </div>
</div>

@code {
    
    private List<PostDto> postsdto = new();
    protected override async Task OnInitializedAsync()
    {
        postsdto = await PostService.GetPostsAsync();
    }

    private void ProfileGit()
    {
        Navigation.NavigateTo("/profil");
    }

    private void MesajlaraGit()
    {
        Navigation.NavigateTo("/mesaj");
    }
}